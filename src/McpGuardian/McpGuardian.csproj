<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>mcp-guardian</AssemblyName>
    <RootNamespace>McpGuardian</RootNamespace>
    <UseAppHost>false</UseAppHost>
    <Version>0.6.0-preview.3</Version>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mcp-guardian</ToolCommandName>
    <PackageId>McpGuardian.Tool</PackageId>
    <Authors>İlhan Emir</Authors>
    <PackageProjectUrl>https://github.com/hanzales/mcp-guardian</PackageProjectUrl>
    <PackageTags>mcp;security;ai-security;model-context-protocol;cli;dotnet-tool</PackageTags>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Description>Security scanner and policy foundation for Model Context Protocol configurations.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/hanzales/mcp-guardian</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
